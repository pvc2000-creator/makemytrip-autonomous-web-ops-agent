# Copy to .env (setup_windows.bat does this for you). Real environment variables override this file.

# ---- Core ----
DATABASE_URL=sqlite:///./webops.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
SNAPSHOT_DIR=./data/runtime_snapshots
CORS_ORIGINS=*

# ---- Browser ----
BROWSER_ENGINE=auto
# true = every run opens a visible Chrome window by default (you can also tick it per run in the UI)
BROWSER_HEADED=false
# fast | normal | slow
BROWSER_SPEED=normal
BROWSER_TIMEOUT_S=20
BROWSER_MAX_RETRIES=2
MAX_CONCURRENT_RUNS=3

# ---- Governance ----
DOMAIN_ALLOWLIST=localhost,127.0.0.1,books.toscrape.com,quotes.toscrape.com
RATE_LIMIT_PER_DOMAIN_PER_MIN=120
MAX_PAGES_PER_RUN=25
MIN_EXTRACTION_CONFIDENCE=0.7
PRICE_CHANGE_THRESHOLD_PCT=3

# ---- Models (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RUN_BUDGET_USD=0.50

# ---- Aviationstack (flight status) ----
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_MONTHLY_LIMIT=90
AVIATIONSTACK_CACHE_TTL_MIN=60
AVIATIONSTACK_ALLOW_HTTP=false

# ---- Scheduler, auth, logs ----
SCHEDULER_ENABLED=true
API_TOKENS=creator-token:creator,reviewer-token:reviewer,admin-token:admin,worker-token:service
LOG_POLLING=false
