[
  {
    "name": "Competitor holiday offers",
    "template": "competitor_offers",
    "objective": "Track competitor holiday package offers, prices and discounts across priority destinations and flag launches, withdrawals and price moves.",
    "target_urls": [
      "{BASE}/mock/offers/tripnova",
      "{BASE}/mock/offers/skyroam"
    ],
    "expected_fields": [
      "competitor",
      "offer_name",
      "destination",
      "price",
      "discount",
      "validity",
      "cta"
    ],
    "schedule": "daily",
    "completion_rules": {
      "alert_on": "material",
      "price_threshold_pct": 3
    },
    "owner_team": "Growth",
    "requires_approval": false,
    "inputs": {}
  },
  {
    "name": "Hotel pricing watch: Goa, Jaipur, Dubai",
    "template": "hotel_pricing",
    "objective": "Watch nightly rates and room availability for tracked hotels for a stay 14 days out and flag significant movement or sell-outs.",
    "target_urls": [
      "{BASE}/mock/hotels/goa",
      "{BASE}/mock/hotels/jaipur",
      "{BASE}/mock/hotels/dubai"
    ],
    "expected_fields": [
      "hotel",
      "city",
      "stay_date",
      "price",
      "availability"
    ],
    "schedule": "hourly",
    "completion_rules": {
      "alert_on": "material",
      "review_on_price_move_pct": 10
    },
    "owner_team": "Pricing & Revenue",
    "requires_approval": true,
    "inputs": {}
  },
  {
    "name": "Campaign landing pages",
    "template": "campaign_page",
    "objective": "Verify headline, offer copy, CTA and placement on active campaign landing pages and note any change.",
    "target_urls": [
      "{BASE}/mock/campaign/summer-sale",
      "{BASE}/mock/campaign/diwali-getaways"
    ],
    "expected_fields": [
      "campaign",
      "headline",
      "offer_text",
      "cta",
      "placement",
      "validity"
    ],
    "schedule": "campaign",
    "completion_rules": {
      "alert_on": "any_copy_change"
    },
    "owner_team": "Marketing Ops",
    "requires_approval": false,
    "inputs": {}
  },
  {
    "name": "Partner update feed",
    "template": "partner_updates",
    "objective": "Follow partner hotel update feed and route new policy, pricing or operational notices to the owning team.",
    "target_urls": [
      "{BASE}/mock/partners"
    ],
    "expected_fields": [
      "partner",
      "title",
      "published",
      "content",
      "category"
    ],
    "schedule": "daily",
    "completion_rules": {
      "alert_on": "new"
    },
    "owner_team": "Partner Ops",
    "requires_approval": false,
    "inputs": {}
  },
  {
    "name": "Destination demand signals",
    "template": "travel_trends",
    "objective": "Scan destination demand index and event signals to spot rising or falling interest for growth planning.",
    "target_urls": [
      "{BASE}/mock/trends"
    ],
    "expected_fields": [
      "destination",
      "search_index",
      "event",
      "trend"
    ],
    "schedule": "weekly",
    "completion_rules": {
      "alert_on": "material",
      "demand_threshold_pct": 15
    },
    "owner_team": "Business Strategy",
    "requires_approval": false,
    "inputs": {}
  },
]
